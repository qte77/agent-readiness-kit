{
  "name": "agent-readiness-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Scans web properties for agent-native readiness (Discovery/Content/Trust/Execution/A2A/Identity) and produces concrete remediation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "scan": "node dist/src/main.js",
    "site:build": "node dist/scripts/buildSiteCli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
